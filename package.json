{
  "name": "hayagawari",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "テスト用の開発依存のみ（単体テストは Node の標準機能、E2E は Playwright）。本体はビルド不要の静的ファイル。",
  "scripts": {
    "test": "node --test \"tests/unit/*.test.mjs\" && node tests/e2e.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node tests/e2e.mjs",
    "check:version": "node tools/check-version.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.56.0"
  }
}
